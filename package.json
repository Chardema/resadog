{
  "name": "la-patte-doree",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "check:env": "CHECK_ENV_TARGET=development node scripts/check-env.mjs",
    "check:env:production": "CHECK_ENV_TARGET=production node scripts/check-env.mjs",
    "check:live": "CHECK_ENV_TARGET=production node scripts/check-env.mjs && node scripts/check-stripe-live.mjs",
    "check:pricing": "tsx scripts/check-pricing.ts",
    "check:pets": "tsx scripts/check-pet-profiles.ts",
    "check:payments": "tsx scripts/check-payment-invariants.ts",
    "check:finance": "tsx scripts/check-finance.ts",
    "check:translations": "node scripts/generate-translations.mjs --check",
    "check:types": "tsc --noEmit",
    "preflight": "npm run check:env && npm run check:two-factor && npm run check:pricing && npm run check:quote-email && npm run check:pets && npm run check:payments && npm run check:attendance && npm run check:finance && npm run check:direct-bookings && npm run check:translations && npm run check:types && npm run lint && npm run build",
    "postinstall": "prisma generate",
    "create-admin": "tsx scripts/create-admin.ts",
    "reset-admin": "tsx scripts/reset-admin-password.ts",
    "check:quote-email": "tsx scripts/check-cat-visit-quote-email.ts",
    "check:attendance": "tsx scripts/check-booking-attendance.ts && tsx scripts/check-booking-notices.ts",
    "check:direct-bookings": "tsx scripts/check-direct-booking.ts && tsx scripts/check-direct-booking-api.ts",
    "check:two-factor": "tsx scripts/check-two-factor.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-pdf/renderer": "4.9.0",
    "@uploadthing/react": "^7.3.3",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.577.0",
    "next": "^16.4.3",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.34.1",
    "stripe": "^20.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "uploadthing": "^7.7.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "brace-expansion": "1.1.21",
    "effect": "3.20.0",
    "eslint-plugin-react-hooks": "7.0.1"
  }
}
