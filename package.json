{
  "name": "la-patte-doree",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:env": "CHECK_ENV_TARGET=development node scripts/check-env.mjs",
    "check:env:production": "CHECK_ENV_TARGET=production node scripts/check-env.mjs",
    "check:live": "CHECK_ENV_TARGET=production node scripts/check-env.mjs && node scripts/check-stripe-live.mjs",
    "check:pricing": "tsx scripts/check-pricing.ts",
    "check:payments": "tsx scripts/check-payment-invariants.ts",
    "check:translations": "node scripts/generate-translations.mjs --check",
    "check:types": "tsc --noEmit",
    "preflight": "npm run check:env && npm run check:pricing && npm run check:payments && npm run check:translations && npm run check:types && npm run lint && npm run build",
    "postinstall": "prisma generate",
    "create-admin": "tsx scripts/create-admin.ts",
    "reset-admin": "tsx scripts/reset-admin-password.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@uploadthing/react": "^7.3.3",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.561.0",
    "next": "^16.2.10",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.16.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "^6.6.0",
    "stripe": "^20.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "uploadthing": "^7.7.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "brace-expansion": "1.1.16",
    "effect": "3.20.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "next": {
      "postcss": "8.5.20"
    }
  }
}
